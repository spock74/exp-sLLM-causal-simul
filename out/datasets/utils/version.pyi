from dataclasses import dataclass

@dataclass
class Version:
    version_str: str
    description: str | None = ...
    major: str | int | None = ...
    minor: str | int | None = ...
    patch: str | int | None = ...
    def __post_init__(self) -> None: ...
    @property
    def tuple(self): ...
    def __eq__(self, other): ...
    def __lt__(self, other): ...
    def __hash__(self): ...
    @classmethod
    def from_dict(cls, dic): ...
